# tiny-paper display firmware, on top of boards/<board>/sdkconfig.defaults

# No WiFi and no network, ever: hal_esp builds its network calls as stubs (Kconfig TINY_NO_WIFI) and nothing references
# the WiFi stack, so the linker leaves it out. tools/check_no_radio.py reads the link map after every build
# (tools/idf/build.sh): no WiFi, no network stack, and Bluetooth reached only through hal_esp's ble_link.c.
CONFIG_TINY_NO_WIFI=y

# Bluetooth Low Energy behind the stored setting, off by default (docs/spec/usb-display.md "Bluetooth"): the NimBLE
# peripheral of hal_esp esp/ble_link.c, started only by main/bt.c when the setting is on. No pairing and no bonds: the
# NimBLE security manager is left out, every frame is sealed with the key made over the cable (usb-display.md
# "Bluetooth key", components/btseal on mbedtls: HKDF and AES-CCM on the hardware AES).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_TINY_BLE=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
CONFIG_BT_NIMBLE_PRINT_ERR_NAME=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=4
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_SCAN=n
CONFIG_BT_CTRL_DTM_ENABLE=n
# No WiFi to share the radio with: without this the startup code would set up coexistence at every boot, Bluetooth
# on or off (check_no_radio.py: coexistence code linked for libesp_system's startup, not for the gate)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# unplugged it wakes every few seconds to look for a USB host (main/main.c): no image check on those wakes
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The display loop runs in the main task (PNG decode, panel driver)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Task watchdog on the idle task and the display loop (hal_esp sys.c): a hang restarts instead of freezing
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# LittleFS on "storage" (hal_esp mounts it; the display writes nothing there)
CONFIG_LITTLEFS_MAX_PARTITIONS=1
